{
  "name": "longbridge-option-quant",
  "version": "16.8.0",
  "description": "基于 Longbridge OpenAPI 的港股双向量化交易系统（TypeScript）",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "bun clean && tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "start": "bun src/index.ts",
    "dev": "cross-env RUN_MODE=dev bun start",
    "dev:watch": "concurrently -k -r \"tsc -p tsconfig.build.json --watch\" \"bun --watch dist/src/index.js\"",
    "type-check": "tsc -p tsconfig.json",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "clean": "rimraf dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . && eslint . --fix"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "longbridge": "^4.2.1",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "^1.3.14",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-unicorn": "^64.0.0",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  }
}
